<?xml version="1.0" encoding="utf-8"?>
<!--
  segby_v1 MuJoCo model — a two-wheel self-balancer (ADR-0008).

  Hand-authored (NOT generated; IR-generated MJCF is a deferred chunk). Dimensions
  and masses mirror the climber reference model:
    * chassis: box 0.07 (X) x 0.15 (Y) x 0.30 (Z), 0.8 kg, freejoint floating base.
    * two wheels: cylinder radius 0.06 m, width 0.025 m, 0.12 kg each, hinge about Y,
      mounted at body-frame z = -0.15 and y = +/- 0.0895 (half_y 0.075 + half-width
      0.0125 + 2 mm gap).
    * spawn body z = 0.22 so wheel bottoms sit ~1 cm above the floor and the bot
      drops onto its wheels at reset.

  CTRL INDEX CONVENTION (load-bearing — matches SegbyV1.Sim.MujocoPlant):
    actuator index 0 = left_wheel_motor   (ctrl[0], driven by motor_left effort)
    actuator index 1 = right_wheel_motor  (ctrl[1], driven by motor_right effort)
  MuJoCo orders actuators by declaration order, so left MUST be declared first.

  SENSORS (read by name in segby_sim.py):
    imu_quat (framequat), imu_gyro (gyro), imu_acc (accelerometer) on the `imu` site,
    plus per-wheel jointpos/jointvel.
-->
<mujoco model="segby_v1">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <geom contype="1" conaffinity="1" friction="1 0.05 0.01"/>
  </default>

  <worldbody>
    <light pos="2 0 5" dir="0 0 -1" diffuse="1 1 1"/>
    <geom name="ground" type="plane" pos="0 0 0" size="20 20 0.1"
          rgba="0.30 0.30 0.30 1"/>

    <body name="chassis" pos="0 0 0.22">
      <freejoint name="root"/>
      <site name="imu" pos="0 0 0" size="0.01"/>

      <!-- chassis: 0.07 x 0.15 x 0.30 box, 0.8 kg (half-sizes below). -->
      <geom name="chassis_geom" type="box" size="0.035 0.075 0.15"
            mass="0.8" rgba="0.7 0.7 0.75 1"/>

      <!-- left wheel: hinge about +Y, cylinder r=0.06 w=0.025 (half-len 0.0125). -->
      <body name="wheel_l" pos="0 0.0895 -0.15">
        <joint name="wheel_l_joint" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom name="wheel_l_geom" type="cylinder" size="0.06 0.0125"
              quat="0.7071068 0.7071068 0 0" mass="0.12" rgba="0.2 0.2 0.2 1"/>
      </body>

      <!-- right wheel: the mirror of the left. -->
      <body name="wheel_r" pos="0 -0.0895 -0.15">
        <joint name="wheel_r_joint" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom name="wheel_r_geom" type="cylinder" size="0.06 0.0125"
              quat="0.7071068 0.7071068 0 0" mass="0.12" rgba="0.2 0.2 0.2 1"/>
      </body>
    </body>
  </worldbody>

  <!--
    Actuators: direct torque on each wheel hinge. ORDER IS LOAD-BEARING:
    index 0 = left (ctrl[0]), index 1 = right (ctrl[1]). ctrlrange ~ +/- 1.0 N.m.

    gear="-1" is the SIM's "motor wiring": it sets the ABSOLUTE sign that decides
    whether the host's commanded torque drives UNDER a fall or amplifies it. The
    host sign convention (+pitch -> negative torque) is pinned host-side by
    preflight_test; whether that physically corrects the fall is the motor/encoder
    direction — on real hardware you'd fix a backwards motor with encoder.invert at
    the bench, here it's this gear sign. Verified in MuJoCo: with gear="-1" the
    host's negative torque induces negative pitch (drives under a forward fall);
    with +1 it amplified the fall. Do NOT "fix" this by flipping the controller
    error sign — that would invert the host convention preflight guards.
  -->
  <actuator>
    <motor name="left_wheel_motor" joint="wheel_l_joint" gear="-1" ctrlrange="-1.0 1.0"/>
    <motor name="right_wheel_motor" joint="wheel_r_joint" gear="-1" ctrlrange="-1.0 1.0"/>
  </actuator>

  <sensor>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acc" site="imu"/>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <jointpos name="wheel_l_pos" joint="wheel_l_joint"/>
    <jointvel name="wheel_l_vel" joint="wheel_l_joint"/>
    <jointpos name="wheel_r_pos" joint="wheel_r_joint"/>
    <jointvel name="wheel_r_vel" joint="wheel_r_joint"/>
  </sensor>
</mujoco>
